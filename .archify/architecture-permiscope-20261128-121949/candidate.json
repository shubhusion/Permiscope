  "cards": [
    {
      "dot": "cyan",
      "title": "Entry points",
      "items": [
        "Agent SDK calls the gateway directly through the adapter",
        "Python and other languages use the loopback HTTP sidecar",
        "MCP tool calls and the console are additional governed consumers"
      ]
    },
    {
      "dot": "rose",
      "title": "Security gates",
      "items": [
        "Credentials live in request context, never on the Action",
        "Verified principals, budgets and policies are shared by decide and execute",
        "Every executed action is bracketed by signed INTENT and RESULT records"
      ]
    },
    {
      "dot": "amber",
      "title": "Detection only",
      "items": [
        "Postconditions and TOCTOU re-resolution report violations after the executor runs",
        "The cache, approval file and audit log are single-machine and file-backed"
      ]
    }
  ]
