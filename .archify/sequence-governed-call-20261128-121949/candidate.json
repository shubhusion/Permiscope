  "cards": [
    {
      "dot": "rose",
      "title": "Strict logging",
      "items": [
        "INTENT is written before any side effect",
        "A failed INTENT write blocks execution in strict mode",
        "RESULT carries the same intentHash and may report sideEffects: committed"
      ]
    },
    {
      "dot": "cyan",
      "title": "Shared decisions",
      "items": [
        "decide() and run() share principal, budget and policy resolution",
        "A decide call records an attempt but never consumes an execution",
        "An Idempotency-Key replays the stored result before run()"
      ]
    },
    {
      "dot": "amber",
      "title": "Detection only",
      "items": [
        "Postconditions and path re-resolution report violations after execution",
        "Optional compensation is best-effort; side effects may remain committed"
      ]
    }
  ]
