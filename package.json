{
  "name": "permiscope",
  "version": "1.1.0",
  "description": "The Trust Layer for AI Agents - Secure gateway for autonomous tools.",
  "main": "dist/index.js",
  "bin": {
    "permiscope": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "audit:verify": "ts-node src/cli/index.ts verify",
    "demo": "node dist/cli/index.js --demo",
    "dev:dashboard": "ts-node src/dashboard/server.ts",
    "serve": "ts-node src/cli/index.ts serve",
    "eval": "ts-node src/cli/index.ts eval",
    "eval:fixture": "ts-node src/scenarios/rogue_agent.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "fixture:web": "ts-node scripts/generate-demo-fixture.ts",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "ai",
    "agents",
    "security",
    "permissions",
    "gateway",
    "trust-layer",
    "llm",
    "policy-engine",
    "automation-security",
    "governance",
    "ai-safety"
  ],
  "author": "Shubham Sharma <shubham27.sharma03@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shubhusion/permiscope.git"
  },
  "homepage": "https://github.com/shubhusion/permiscope",
  "bugs": {
    "url": "https://github.com/shubhusion/permiscope/issues"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "files": [
    "dist"
  ],
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "fast-json-stable-stringify": "^2.1.0",
    "proper-lockfile": "^4.1.2",
    "safe-regex": "^2.1.1",
    "shell-quote": "^1.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/safe-regex": "^1.1.6",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.9",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "^8.4.0"
  }
}
