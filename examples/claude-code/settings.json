{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|Read|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "npx",
            "args": ["-y", "permiscope@2.1.0", "hook"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
