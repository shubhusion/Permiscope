{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Write|Edit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y permiscope@2.1.0 hook codex",
            "timeout": 30,
            "statusMessage": "Checking Permiscope policy"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash|apply_patch|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y permiscope@2.1.0 hook codex"
          }
        ]
      }
    ]
  }
}
